<Window x:Class="FULBO9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FULBO9"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!--Paleta de Colores-->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF1976D2"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FF42A5F5"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF1565C0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD32F2F"/>
        <SolidColorBrush x:Key="LightTextBrush" Color="White"/>
        <SolidColorBrush x:Key="DarkTextBrush" Color="#212121"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="BackgroundLightBrush" Color="White"/>
        <SolidColorBrush x:Key="BackgroundMediumBrush" Color="#FFF5F5F5"/>
    </Window.Resources>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    <Grid>
        <Menu>
            <MenuItem Header="Tabla Posiciones"></MenuItem>
            <MenuItem Header="Goles"></MenuItem>
            <MenuItem Header="Resultados"></MenuItem>
            <MenuItem Header="Calendario"></MenuItem>
            <MenuItem Header="Grupos"></MenuItem>
            <MenuItem Header="Jugadores" Click="AbrirJugadores"></MenuItem>
            <MenuItem Header="Equipos" Click="AbrirEquipos"></MenuItem>
            <MenuItem Header="Configuracion" Click="AbrirConfiguracion"></MenuItem>
        </Menu>
        <!-- Frame: aquí se cargan las páginas -->
        <Frame x:Name="FramePrincipal"
               Grid.Row="1"
               NavigationUIVisibility="Hidden" />
    </Grid>
</Window>

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
