<Page x:Class="FULBO9.Paginas.Equipos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FULBO9.Paginas"
        mc:Ignorable="d"
        Title="Equipos" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dtgEquipos">
            <!--Definición Manual de Columnas-->
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="*" Visibility="Collapsed" Binding="{Binding ID}"/>
                <DataGridTextColumn Header="Nombre Equipo" Width="*" Binding="{Binding NombreEquipo}"/>
                <DataGridTextColumn Header="Delegado" Width="*"/>
                <DataGridTextColumn Header="Móvil Delegado" Width="*"/>
                <DataGridTextColumn Header="Forma de Pago" Width="*"/>
                <DataGridTextColumn Header="Monto" Width="*"/>
                <DataGridTextColumn Header="Fecha Pago" Width="*"/>
                <DataGridTextColumn Header="Estado" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
